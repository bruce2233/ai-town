{
    "compilerOptions": {
        "target": "es2015",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "skipLibCheck": true,
        "downlevelIteration": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*"
    ]
}